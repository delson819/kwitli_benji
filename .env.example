# Copier vers .env seulement s'il n'existe pas deja, puis remplacer les valeurs.
# Utiliser un mot de passe alphanumerique URL-safe ou l'encoder dans DATABASE_URL.
KWITLI_POSTGRES_DB=kwitli_docker
KWITLI_POSTGRES_USER=kwitli_docker
KWITLI_POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=replace-with-a-unique-random-secret
DATABASE_URL=postgresql+psycopg2://kwitli_docker:replace-with-a-random-url-safe-password@postgres:5432/kwitli_docker
