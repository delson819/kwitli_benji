APP_NAME=Kwitli
APP_ENV=development
APP_DEBUG=true
LAUNCH_COUNTRY=SN
UI_LOCALE=fr
CURRENCY=XOF
# Fuseau de secours uniquement ; le fuseau du marche actif est resolu depuis LAUNCH_COUNTRY.
MARKET_TIMEZONE=UTC
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_API_URL=
# PostgreSQL local DEV (socket Unix sur cette machine; aucun mot de passe dans Git).
DATABASE_URL=postgresql+psycopg2:///kwitli_dev?host=/tmp&port=55433
# Base isolée obligatoire pour pytest. Ne jamais remplacer par kwitli_dev.
TEST_DATABASE_URL=postgresql+psycopg2:///kwitli_test?host=/tmp&port=55433
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=kwitli-api
JWT_AUDIENCE=kwitli-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kwitli <noreply@mail.kwitli.app>
PASSWORD_RESET_APP_URL=kwitli://reset-password
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_WIDTH=4096
UPLOAD_MAX_HEIGHT=4096
UPLOAD_MAX_PIXELS=12000000
UPLOAD_DIR=backend/uploads
# KYB désactivé tant que chiffrement privé et ClamAV ne sont pas opérationnels.
KYB_ENABLED=false
KYB_ENFORCED_COUNTRIES=
KYB_PRIVATE_STORAGE_DIR=/var/lib/kwitli/kyb-private
KYB_ENCRYPTION_KEY=
KYB_ENCRYPTION_KEYS=
KYB_ENCRYPTION_KEY_VERSION=v1
KYB_MAX_DOCUMENT_BYTES=10485760
KYB_CLAMDSCAN_PATH=clamdscan
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
PAYU_ENV=sandbox
PAYDUNYA_MODE=sandbox
XOF_PAYMENT_PROVIDER=flutterwave
FLUTTERWAVE_ENV=test
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYTECH_ENV=test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Compte fictif cree dans PayDunya Sandbox, jamais un compte client reel.
PAYDUNYA_TEST_CUSTOMER_PHONE=
PAYDUNYA_TEST_CUSTOMER_EMAIL=
PAYDUNYA_TEST_CUSTOMER_PASSWORD=
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_PUBLIC_KEY=
PAYU_API_BASE_URL=https://sandbox.api.payulatam.com/payments-api/4.0/service.cgi
PAYU_CHECKOUT_URL=
PAYMENT_HOLD_MINUTES=10
CHECKOUT_TOKEN_EXPIRE_MINUTES=10
MAX_ACTIVE_HOLDS_PER_USER=3
MAX_HELD_PORTIONS_PER_USER=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_REGISTER_REQUESTS=10
RATE_LIMIT_PAYMENT_REQUESTS=10
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_PICKUP_REQUESTS=10
RATE_LIMIT_REVIEW_REQUESTS=10
RATE_LIMIT_DISCOVER_REQUESTS=60
RATE_LIMIT_MAX_BUCKETS=10000
TRUSTED_PROXY_IPS=127.0.0.1,::1
