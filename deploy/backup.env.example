# Modèle sans identifiants. Copier hors du dépôt vers /etc/kwitli/backup.env.
KWITLI_COMPOSE_ENV_FILE=/etc/kwitli/production.env
KWITLI_COMPOSE_FILE=/opt/kwitli/deploy/compose.production.yaml

# Le chemin /production distingue le dépôt actif des dépôts /validation/<id>.
# Remplacer ACCOUNT_ID localement; ne pas mettre de clé secrète dans ce fichier exemple.
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com/kwitli-restic-backups/production
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=replace-from-password-manager
AWS_SECRET_ACCESS_KEY=replace-from-password-manager

# Mot de passe de chiffrement Restic distinct des identifiants R2.
RESTIC_PASSWORD_FILE=/etc/kwitli/restic-password
