# Modèle sans secrets de fournisseur. Créer le vrai fichier sous /etc/kwitli.
# Générer une clé distincte par environnement directement sur Hetzner.
SECRET_KEY=<generate-at-least-32-random-characters-on-server>
SERVICE_AREA_MANIFEST_PATH=/run/kwitli/service-areas.json

# Préproduction contrôlée : tous les fournisseurs restent en mode test.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

PAYU_ENV=sandbox
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_PUBLIC_KEY=
PAYU_API_BASE_URL=
PAYU_CHECKOUT_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu/

PAYDUNYA_MODE=sandbox
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_TEST_CUSTOMER_PHONE=
PAYDUNYA_TEST_CUSTOMER_EMAIL=
PAYDUNYA_TEST_CUSTOMER_PASSWORD=

FLUTTERWAVE_ENV=test
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYTECH_ENV=test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=

# Pas d'envoi externe de courriel en préproduction initiale.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kwitli <noreply@mail.kwitli.app>
