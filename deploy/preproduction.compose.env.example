# Modèle Compose sans secret. Créer le vrai fichier sous /etc/kwitli sur Hetzner.
KWITLI_APP_ENV=staging
KWITLI_IMAGE=ghcr.io/<owner>/kwitli-api@sha256:<verified-multiarch-manifest-digest>
KWITLI_API_ENV_FILE=/etc/kwitli/preproduction.api.env
SERVICE_AREA_MANIFEST_FILE=/etc/kwitli/preproduction.service-areas.json

KWITLI_POSTGRES_DB=kwitli_preproduction
KWITLI_POSTGRES_USER=kwitli_preproduction
KWITLI_POSTGRES_PASSWORD=<generate-64-hex-characters-on-server>
DATABASE_URL=postgresql+psycopg2://kwitli_preproduction:<same-64-hex-characters>@postgres:5432/kwitli_preproduction

PUBLIC_API_URL=https://api.kwitli.app
TRUSTED_PROXY_IPS=172.30.0.2
