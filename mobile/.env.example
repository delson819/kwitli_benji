# Optionnel en developpement sur simulateur : iOS/web utilisent 127.0.0.1:8000,
# Android Emulator utilise 10.0.2.2:8000, sans adb reverse.
# Sur un telephone reel, definir l'adresse LAN du Mac :
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
# Pour un build staging ou production, EXPO_PUBLIC_API_URL est obligatoire et doit etre une origine HTTPS publique.
# L'URL staging sera api.kwitli.app après validation et activation contrôlée du DNS/HTTPS.
# EXPO_PUBLIC_API_URL=https://api.kwitli.app
EXPO_PUBLIC_MARKET_CODE=SN
# Fuseau du marche operationnel pour l'affichage, sans activer ses autres reglages produit.
EXPO_PUBLIC_TIMEZONE_MARKET_CODE=SN
# Dernier fallback timezone ; SN resout Africa/Dakar via son code marche.
EXPO_PUBLIC_MARKET_TIMEZONE=UTC
# Les zones actives sont chargées depuis GET /api/v1/service-areas.
# Aucun fallback de ville n'est requis dans le .env mobile.
