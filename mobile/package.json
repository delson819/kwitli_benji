{
  "name": "kwitli-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:staging": "node scripts/start-staging.cjs",
    "android": "expo run:android",
    "ios": "node scripts/start-ios-local.cjs",
    "web": "expo start --web",
    "test:discovery": "node --experimental-strip-types src/discovery.test.ts",
    "test:order-actions": "node --experimental-strip-types src/order-actions.test.ts && node src/order-actions-ui.test.cjs",
    "test:cart-payment": "node src/cart-payment.test.cjs",
    "test:payment-ui": "node src/payment-ui-state.test.cjs",
    "test:location": "node src/location.test.cjs",
    "test:market-timezone": "node src/market-timezone.test.cjs",
    "test:api-url": "node --experimental-strip-types src/api-url.test.ts",
    "test:api-debug": "node src/api-auth-diagnostics.test.cjs",
    "test:api-staging": "node --experimental-strip-types src/api-staging-launch.test.cjs",
    "test:eas-preview": "node src/eas-preview-config.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:session": "node --experimental-strip-types src/secure-session.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-devtools-core": {
      "shell-quote": "1.11.0"
    }
  }
}
